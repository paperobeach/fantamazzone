# ============================================================
# .env.example — copia in .env e adatta
# ============================================================

# URL base dell'API PHP (senza slash finale)
# In sviluppo locale con proxy Vite: lascia /api
# In produzione su Altervista: inserisci l'URL completo
VITE_API_URL=/api

# Esempio produzione:
# VITE_API_URL=https://tuonome.altervista.org/api
